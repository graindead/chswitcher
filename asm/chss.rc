// Resources: the main window (a dialog template) and version info.
#include <windows.h>

#define IDC_HOST    101
#define IDC_PORT    102
#define IDC_PASS    103
#define IDC_CONNECT 104
#define IDC_SONG    105
#define IDC_MENU    106
#define IDC_DELAY   107
#define IDC_FILE    108
#define IDC_BROWSE  109
#define IDC_CONN    110
#define IDC_EVENT   111

1 DIALOGEX 0, 0, 250, 172
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "CH Scene Switcher"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "OBS WebSocket", -1, 7, 4, 236, 50
    LTEXT           "Server IP", -1, 14, 18, 42, 8
    EDITTEXT        IDC_HOST, 58, 16, 90, 12, ES_AUTOHSCROLL
    LTEXT           "Port", -1, 156, 18, 20, 8
    EDITTEXT        IDC_PORT, 178, 16, 58, 12, ES_NUMBER
    LTEXT           "Password", -1, 14, 35, 42, 8
    EDITTEXT        IDC_PASS, 58, 33, 90, 12, ES_PASSWORD | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Connect", IDC_CONNECT, 178, 32, 58, 14

    GROUPBOX        "Scenes", -1, 7, 58, 236, 64
    LTEXT           "Song playing", -1, 14, 72, 44, 8
    COMBOBOX        IDC_SONG, 58, 70, 178, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "In menus", -1, 14, 89, 44, 8
    COMBOBOX        IDC_MENU, 58, 87, 178, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Delay (sec)", -1, 14, 106, 44, 8
    EDITTEXT        IDC_DELAY, 58, 104, 30, 12, ES_AUTOHSCROLL
    LTEXT           "before switching back to the menu scene", -1, 94, 106, 142, 8

    LTEXT           "Song file", -1, 9, 130, 46, 8
    EDITTEXT        IDC_FILE, 58, 128, 158, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE, 220, 127, 23, 14

    LTEXT           "", IDC_CONN, 9, 148, 234, 9, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT           "", IDC_EVENT, 9, 159, 234, 9, SS_ENDELLIPSIS | SS_NOPREFIX
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Switches OBS scenes when Clone Hero starts and ends songs"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "chss"
            VALUE "OriginalFilename", "CH Scene Switcher.exe"
            VALUE "ProductName",      "CH Scene Switcher"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
