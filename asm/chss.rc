// Resources: the main window (a dialog template) and version info.
#include <windows.h>

#define IDC_HOST    101
#define IDC_PORT    102
#define IDC_PASS    103
#define IDC_CONNECT 104
#define IDC_SONG    105
#define IDC_MENU    106
#define IDC_DELAY   107
#define IDC_FILE    108
#define IDC_BROWSE  109
#define IDC_CONN    110
#define IDC_NAV     112
#define IDC_USEMODE 113
#define IDC_ACTIVE  114
#define IDC_DOT     115
#define IDC_STATUS  116
#define IDC_DIVIDER 117
// page labels (shown and hidden with their page)
#define IDL_HOST    120
#define IDL_PORT    121
#define IDL_PASS    122
#define IDL_SONG    123
#define IDL_MENU    124
#define IDL_FILE    125
#define IDL_DELAY   126

// Two panes: the page list on the left (drawn by the app), the selected page on
// the right. Every page's controls are here; the app shows only the current page's.
1 DIALOGEX 0, 0, 250, 102
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "CH Scene Switcher"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_NAV, "ListBox", LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_TABSTOP, 0, 4, 66, 98
    LTEXT           "", IDC_DIVIDER, 66, 0, 1, 102

    // Connection
    LTEXT           "Server IP", IDL_HOST, 76, 8, 166, 8
    EDITTEXT        IDC_HOST, 76, 18, 166, 12, ES_AUTOHSCROLL
    LTEXT           "Port", IDL_PORT, 76, 36, 44, 8
    EDITTEXT        IDC_PORT, 76, 46, 44, 12, ES_NUMBER
    LTEXT           "Password", IDL_PASS, 128, 36, 114, 8
    EDITTEXT        IDC_PASS, 128, 46, 114, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_CONN, 76, 63, 110, 17, SS_NOPREFIX
    DEFPUSHBUTTON   "Connect", IDC_CONNECT, 192, 62, 50, 14

    // Singleplayer / Multiplayer (same controls, showing the selected mode's scenes)
    LTEXT           "Song playing", IDL_SONG, 76, 8, 166, 8
    COMBOBOX        IDC_SONG, 76, 18, 166, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "In menus", IDL_MENU, 76, 36, 166, 8
    COMBOBOX        IDC_MENU, 76, 46, 166, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // Song file
    LTEXT           "Song file", IDL_FILE, 76, 8, 166, 8
    EDITTEXT        IDC_FILE, 76, 18, 142, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE, 221, 17, 21, 14
    LTEXT           "Delay before switching to the menu scene (sec)", IDL_DELAY, 76, 36, 166, 8
    EDITTEXT        IDC_DELAY, 76, 46, 30, 12, ES_AUTOHSCROLL

    // status row, on every page
    LTEXT           "", IDC_DOT, 76, 85, 7, 9, SS_NOPREFIX
    LTEXT           "", IDC_STATUS, 84, 85, 100, 9, SS_ENDELLIPSIS | SS_NOPREFIX
    PUSHBUTTON      "Use this mode", IDC_USEMODE, 186, 82, 56, 14
    RTEXT           "Active mode", IDC_ACTIVE, 186, 85, 56, 9
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Switches OBS scenes when Clone Hero starts and ends songs"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "chss"
            VALUE "OriginalFilename", "CH Scene Switcher.exe"
            VALUE "ProductName",      "CH Scene Switcher"
            VALUE "ProductVersion",   "1.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
