// Version info shown in the exe's Properties -> Details tab. A normal-looking
// version resource also helps antivirus heuristics treat the exe as a regular app.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Switches OBS scenes when Clone Hero starts and ends songs"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "chss"
            VALUE "OriginalFilename", "CH Scene Switcher.exe"
            VALUE "ProductName",      "CH Scene Switcher"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
